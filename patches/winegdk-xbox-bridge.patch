diff --git a/dlls/xgameruntime/GDKComponent/System/User/Token.c b/dlls/xgameruntime/GDKComponent/System/User/Token.c
index 1e391e0203..f0d80465d9 100644
--- a/dlls/xgameruntime/GDKComponent/System/User/Token.c
+++ b/dlls/xgameruntime/GDKComponent/System/User/Token.c
@@ -456,0 +457,101 @@ HRESULT ParseJsonObject( LPCSTR str, UINT32 str_size, IJsonObject **object )
+static HRESULT HStringFromUtf8( LPCSTR value, HSTRING *result )
+{
+    INT length, written;
+    LPWSTR wide;
+    HRESULT hr;
+
+    if (!value || !result) return E_POINTER;
+    *result = NULL;
+    length = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, value, -1,
+                                  NULL, 0 );
+    if (length <= 1) return HRESULT_FROM_WIN32( GetLastError() );
+    if (!(wide = calloc( length, sizeof( *wide ) ))) return E_OUTOFMEMORY;
+    written = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, value, -1,
+                                   wide, length );
+    if (written != length)
+    {
+        free( wide );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    hr = WindowsCreateString( wide, length - 1, result );
+    free( wide );
+    return hr;
+}
+
+static HRESULT LoadPreauthenticatedOAuth( time_t *expiry,
+                                           HSTRING *refresh_token,
+                                           HSTRING *oauth_token )
+{
+    const char *path = getenv( "WINEGDK_PREAUTH_OAUTH" );
+    HANDLE file;
+    LPSTR buffer = NULL, expiry_end, oauth, oauth_end, refresh, refresh_end;
+    DWORD size, read = 0;
+    unsigned long long parsed;
+    LPSTR end;
+    HRESULT hr = E_FAIL;
+
+    if (!path || !*path || !expiry || !refresh_token || !oauth_token)
+        return E_INVALIDARG;
+    *refresh_token = NULL;
+    *oauth_token = NULL;
+
+    file = CreateFileA( path, GENERIC_READ, FILE_SHARE_READ, NULL,
+            OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32( GetLastError() );
+
+    size = GetFileSize( file, NULL );
+    if (!size || size >= 64 * 1024 ||
+        !(buffer = calloc( 1, size + 1 )) ||
+        !ReadFile( file, buffer, size, &read, NULL ) || read != size)
+        goto done;
+
+    expiry_end = strchr( buffer, '\n' );
+    oauth = expiry_end ? expiry_end + 1 : NULL;
+    oauth_end = oauth ? strchr( oauth, '\n' ) : NULL;
+    refresh = oauth_end ? oauth_end + 1 : NULL;
+    refresh_end = refresh ? strchr( refresh, '\n' ) : NULL;
+    if (!expiry_end || !oauth || !oauth_end || oauth == oauth_end ||
+        !refresh || !refresh_end || refresh == refresh_end ||
+        refresh_end[1] || strchr( buffer, '\r' ))
+        goto done;
+
+    *expiry_end = 0;
+    *oauth_end = 0;
+    *refresh_end = 0;
+    parsed = strtoull( buffer, &end, 10 );
+    if (end == buffer || *end || !parsed ||
+        parsed > 0x7fffffffffffffffULL ||
+        (time_t)parsed <= time( NULL ) + 30)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+
+    if (FAILED( hr = HStringFromUtf8( oauth, oauth_token ) ) ||
+        FAILED( hr = HStringFromUtf8( refresh, refresh_token ) ))
+        goto done;
+
+    *expiry = (time_t)parsed;
+    hr = S_OK;
+    TRACE( "loaded launcher OAuth credentials\n" );
+
+done:
+    free( buffer );
+    CloseHandle( file );
+    if (FAILED( hr ))
+    {
+        if (*refresh_token)
+        {
+            WindowsDeleteString( *refresh_token );
+            *refresh_token = NULL;
+        }
+        if (*oauth_token)
+        {
+            WindowsDeleteString( *oauth_token );
+            *oauth_token = NULL;
+        }
+    }
+    return hr;
+}
+
@@ -468,0 +570,6 @@ HRESULT RefreshOAuth( LPCSTR client_id, LPCSTR refresh_token, time_t *new_expiry
+    *new_refresh_token = NULL;
+    *new_oauth_token = NULL;
+    hr = LoadPreauthenticatedOAuth( new_expiry, new_refresh_token,
+                                    new_oauth_token );
+    if (SUCCEEDED( hr )) return S_OK;
+    WARN( "launcher OAuth credentials unavailable: 0x%08lx\n", hr );
diff --git a/dlls/xgameruntime/GDKComponent/System/User/XUser.c b/dlls/xgameruntime/GDKComponent/System/User/XUser.c
index 57a68eae42..8f4afbb26d 100644
--- a/dlls/xgameruntime/GDKComponent/System/User/XUser.c
+++ b/dlls/xgameruntime/GDKComponent/System/User/XUser.c
@@ -140,0 +141,289 @@ static struct x_user *signed_in_user_snapshot( void )
+struct bridge_field
+{
+    const BYTE *data;
+    UINT32 size;
+};
+
+enum bridge_field_index
+{
+    BRIDGE_USER_TOKEN,
+    BRIDGE_XBL_TOKEN,
+    BRIDGE_XBL_XUID,
+    BRIDGE_XBL_GAMERTAG,
+    BRIDGE_XBL_MODERN_GAMERTAG,
+    BRIDGE_XBL_MODERN_GAMERTAG_SUFFIX,
+    BRIDGE_XBL_UNIQUE_MODERN_GAMERTAG,
+    BRIDGE_XBL_AGE_GROUP,
+    BRIDGE_XBL_UHS,
+    BRIDGE_XBL_PRIVILEGES_PRESENT,
+    BRIDGE_XBL_PRIVILEGES,
+    BRIDGE_USER_EXPIRY,
+    BRIDGE_XBL_EXPIRY,
+    BRIDGE_SISU_TOKEN,
+    BRIDGE_SISU_UHS,
+    BRIDGE_SISU_RP,
+    BRIDGE_SISU_EXPIRY,
+    BRIDGE_MP_TOKEN,
+    BRIDGE_MP_UHS,
+    BRIDGE_MP_RP,
+    BRIDGE_MP_EXPIRY,
+    BRIDGE_REALMS_TOKEN,
+    BRIDGE_REALMS_UHS,
+    BRIDGE_REALMS_RP,
+    BRIDGE_REALMS_EXPIRY,
+    BRIDGE_LIC_TOKEN,
+    BRIDGE_LIC_UHS,
+    BRIDGE_LIC_RP,
+    BRIDGE_LIC_EXPIRY,
+    BRIDGE_FIELD_COUNT
+};
+
+static UINT32 bridge_read_u32( const BYTE *value )
+{
+    return value[0] | ((UINT32)value[1] << 8) |
+           ((UINT32)value[2] << 16) | ((UINT32)value[3] << 24);
+}
+
+static HRESULT bridge_hstring( const struct bridge_field *field, HSTRING *value )
+{
+    INT length;
+    LPWSTR wide;
+    HRESULT hr;
+
+    if (!field || !value) return E_POINTER;
+    *value = NULL;
+    if (!field->size) return E_INVALIDARG;
+    if (memchr( field->data, 0, field->size )) return E_INVALIDARG;
+    length = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS,
+                                  (LPCSTR)field->data, field->size, NULL, 0 );
+    if (!length) return HRESULT_FROM_WIN32( GetLastError() );
+    if (!(wide = calloc( length, sizeof( *wide ) ))) return E_OUTOFMEMORY;
+    if (MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS,
+                             (LPCSTR)field->data, field->size,
+                             wide, length ) != length)
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        free( wide );
+        return hr;
+    }
+    hr = WindowsCreateString( wide, length, value );
+    free( wide );
+    return hr;
+}
+
+static HRESULT bridge_u64( const struct bridge_field *field, UINT64 *value )
+{
+    UINT64 parsed = 0;
+    UINT32 i;
+
+    if (!field || !value || !field->size || field->size > 20)
+        return E_INVALIDARG;
+    for (i = 0; i < field->size; ++i)
+    {
+        UINT64 digit;
+        if (field->data[i] < '0' || field->data[i] > '9')
+            return E_INVALIDARG;
+        digit = field->data[i] - '0';
+        if (parsed > (~(UINT64)0 - digit) / 10)
+            return E_INVALIDARG;
+        parsed = parsed * 10 + digit;
+    }
+    if (!parsed) return E_INVALIDARG;
+    *value = parsed;
+    return S_OK;
+}
+
+static HRESULT bridge_copy( const struct bridge_field *field,
+                            LPSTR value, SIZE_T capacity )
+{
+    if (!field || !value || !capacity || field->size >= capacity ||
+        memchr( field->data, 0, field->size ))
+        return E_INVALIDARG;
+    memcpy( value, field->data, field->size );
+    value[field->size] = 0;
+    return S_OK;
+}
+
+static void clear_bridge_user( struct x_user *user )
+{
+    WindowsDeleteString( user->user_token );
+    WindowsDeleteString( user->xsts_token );
+    WindowsDeleteString( user->xbl_privileges );
+    WindowsDeleteString( user->sisu_token );
+    WindowsDeleteString( user->mp_token );
+    WindowsDeleteString( user->realms_token );
+    WindowsDeleteString( user->lic_token );
+    user->user_token = NULL;
+    user->xsts_token = NULL;
+    user->xbl_privileges = NULL;
+    user->sisu_token = NULL;
+    user->mp_token = NULL;
+    user->realms_token = NULL;
+    user->lic_token = NULL;
+}
+
+static HRESULT LoadBridgeUser( struct x_user *user )
+{
+    const char *path = getenv( "WINEGDK_PREAUTH_DEVICE" );
+    struct bridge_field fields[BRIDGE_FIELD_COUNT];
+    HANDLE file = INVALID_HANDLE_VALUE;
+    BYTE *buffer = NULL;
+    DWORD size, read = 0;
+    UINT32 count, length;
+    UINT64 value;
+    SIZE_T offset;
+    HRESULT hr = E_FAIL;
+    unsigned int i;
+
+    if (!user || !path || !*path) return E_INVALIDARG;
+    if ((file = CreateFileA( path, GENERIC_READ, FILE_SHARE_READ, NULL,
+                             OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL,
+                             NULL )) == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32( GetLastError() );
+    size = GetFileSize( file, NULL );
+    if (size < 12 || size > 512 * 1024 ||
+        !(buffer = malloc( size )) ||
+        !ReadFile( file, buffer, size, &read, NULL ) || read != size)
+        goto done;
+    if (memcmp( buffer, "BLGDKXB1", 8 ) ||
+        (count = bridge_read_u32( buffer + 8 )) != BRIDGE_FIELD_COUNT)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    offset = 12;
+    for (i = 0; i < count; ++i)
+    {
+        if (offset > size || size - offset < 4)
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        length = bridge_read_u32( buffer + offset );
+        offset += 4;
+        if (offset > size || length > size - offset ||
+            memchr( buffer + offset, 0, length ))
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        fields[i].data = buffer + offset;
+        fields[i].size = length;
+        offset += length;
+    }
+    if (offset != size)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+
+    if (FAILED( hr = bridge_hstring( &fields[BRIDGE_USER_TOKEN],
+                                      &user->user_token ) ) ||
+        FAILED( hr = bridge_hstring( &fields[BRIDGE_XBL_TOKEN],
+                                      &user->xsts_token ) ) ||
+        FAILED( hr = bridge_u64( &fields[BRIDGE_XBL_XUID], &user->xuid ) ) ||
+        FAILED( hr = bridge_u64( &fields[BRIDGE_XBL_UHS],
+                                 &user->local_id.value ) ) ||
+        FAILED( hr = bridge_copy( &fields[BRIDGE_XBL_GAMERTAG],
+                                  user->gamertag,
+                                  sizeof( user->gamertag ) ) ))
+        goto done;
+
+    if (!fields[BRIDGE_XBL_MODERN_GAMERTAG].size)
+        lstrcpynA( user->modern_gamertag, user->gamertag,
+                   sizeof( user->modern_gamertag ) );
+    else if (FAILED( hr = bridge_copy(
+                         &fields[BRIDGE_XBL_MODERN_GAMERTAG],
+                         user->modern_gamertag,
+                         sizeof( user->modern_gamertag ) ) ))
+        goto done;
+    if (!fields[BRIDGE_XBL_UNIQUE_MODERN_GAMERTAG].size)
+        lstrcpynA( user->unique_modern_gamertag, user->gamertag,
+                   sizeof( user->unique_modern_gamertag ) );
+    else if (FAILED( hr = bridge_copy(
+                         &fields[BRIDGE_XBL_UNIQUE_MODERN_GAMERTAG],
+                         user->unique_modern_gamertag,
+                         sizeof( user->unique_modern_gamertag ) ) ))
+        goto done;
+    if (FAILED( hr = bridge_copy(
+                    &fields[BRIDGE_XBL_MODERN_GAMERTAG_SUFFIX],
+                    user->modern_gamertag_suffix,
+                    sizeof( user->modern_gamertag_suffix ) ) ))
+        goto done;
+
+    if (fields[BRIDGE_XBL_AGE_GROUP].size == 5 &&
+        !memcmp( fields[BRIDGE_XBL_AGE_GROUP].data, "Adult", 5 ))
+        user->age_group = XUserAgeGroup_Adult;
+    else if (fields[BRIDGE_XBL_AGE_GROUP].size == 4 &&
+             !memcmp( fields[BRIDGE_XBL_AGE_GROUP].data, "Teen", 4 ))
+        user->age_group = XUserAgeGroup_Teen;
+    else
+        user->age_group = XUserAgeGroup_Child;
+
+    if (fields[BRIDGE_XBL_PRIVILEGES_PRESENT].size != 1 ||
+        (fields[BRIDGE_XBL_PRIVILEGES_PRESENT].data[0] != '0' &&
+         fields[BRIDGE_XBL_PRIVILEGES_PRESENT].data[0] != '1'))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    user->xbl_privileges_present =
+        fields[BRIDGE_XBL_PRIVILEGES_PRESENT].data[0] == '1';
+    if (user->xbl_privileges_present &&
+        fields[BRIDGE_XBL_PRIVILEGES].size &&
+        FAILED( hr = bridge_hstring( &fields[BRIDGE_XBL_PRIVILEGES],
+                                      &user->xbl_privileges ) ))
+        goto done;
+
+    if (FAILED( hr = bridge_u64( &fields[BRIDGE_USER_EXPIRY], &value ) ))
+        goto done;
+    user->user_token_expiry = (time_t)value;
+    if (FAILED( hr = bridge_u64( &fields[BRIDGE_XBL_EXPIRY], &value ) ))
+        goto done;
+    user->xsts_token_expiry = (time_t)value;
+    if (user->user_token_expiry <= time( NULL ) + 30 ||
+        user->xsts_token_expiry <= time( NULL ) + 30)
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+
+#define LOAD_AUDIENCE(name, upper) \
+    do \
+    { \
+        if (FAILED( hr = bridge_hstring( &fields[BRIDGE_##upper##_TOKEN], \
+                                          &user->name##_token ) ) || \
+            FAILED( hr = bridge_u64( &fields[BRIDGE_##upper##_UHS], \
+                                      &user->name##_uhs ) ) || \
+            FAILED( hr = bridge_copy( &fields[BRIDGE_##upper##_RP], \
+                                       user->name##_rp, \
+                                       sizeof( user->name##_rp ) ) ) || \
+            FAILED( hr = bridge_u64( &fields[BRIDGE_##upper##_EXPIRY], \
+                                      &value ) ) ) \
+            goto done; \
+        user->name##_expiry = (time_t)value; \
+        if (user->name##_expiry <= time( NULL ) + 30) \
+        { \
+            hr = E_FAIL; \
+            goto done; \
+        } \
+    } while (0)
+
+    LOAD_AUDIENCE( sisu, SISU );
+    LOAD_AUDIENCE( mp, MP );
+    LOAD_AUDIENCE( realms, REALMS );
+    if (fields[BRIDGE_LIC_TOKEN].size)
+        LOAD_AUDIENCE( lic, LIC );
+#undef LOAD_AUDIENCE
+
+    hr = S_OK;
+    TRACE( "loaded launcher Xbox credentials\n" );
+
+done:
+    if (FAILED( hr )) clear_bridge_user( user );
+    free( buffer );
+    if (file != INVALID_HANDLE_VALUE) CloseHandle( file );
+    return hr;
+}
+
@@ -209,0 +499,6 @@ static HRESULT LoadDefaultUser( XUserHandle *user, LPCSTR client_id )
+    hr = LoadBridgeUser( impl );
