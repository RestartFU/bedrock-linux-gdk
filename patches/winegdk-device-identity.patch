+static HRESULT DeviceAuth_OpenAlgorithms( void )
+{
+    NTSTATUS status;
+
+    if (!g_ecdsa_alg)
+    {
+        status = BCryptOpenAlgorithmProvider( &g_ecdsa_alg,
+                                              BCRYPT_ECDSA_P256_ALGORITHM,
+                                              NULL, 0 );
+        if (status)
+            return HRESULT_FROM_NT( status );
+    }
+    if (!g_sha256_alg)
+    {
+        status = BCryptOpenAlgorithmProvider( &g_sha256_alg,
+                                              BCRYPT_SHA256_ALGORITHM,
+                                              NULL, 0 );
+        if (status)
+            return HRESULT_FROM_NT( status );
+    }
+    return S_OK;
+}
+
+HRESULT DeviceAuth_InitializePreauthenticated(
+    const BYTE *device_token, UINT32 device_token_len,
+    const BYTE *device_id, UINT32 device_id_len,
+    const BYTE *private_blob_b64, UINT32 private_blob_b64_len )
+{
+    BCRYPT_KEY_HANDLE key = NULL;
+    BCRYPT_ECCKEY_BLOB *header;
+    HSTRING token = NULL;
+    BYTE public_blob[128];
+    BYTE *private_blob = NULL;
+    LPWSTR token_wide = NULL;
+    DWORD private_blob_len = 0;
+    ULONG public_blob_len = 0;
+    INT token_wide_len;
+    NTSTATUS status;
+    HRESULT hr;
+
+    if (g_initialized) return S_OK;
+    if (!device_token || !device_token_len ||
+        !device_id || !device_id_len || device_id_len >= sizeof( g_device_id ) ||
+        !private_blob_b64 || !private_blob_b64_len ||
+        memchr( device_token, 0, device_token_len ) ||
+        memchr( device_id, 0, device_id_len ) ||
+        memchr( private_blob_b64, 0, private_blob_b64_len ))
+        return E_INVALIDARG;
+
+    if (FAILED( hr = DeviceAuth_OpenAlgorithms() ))
+        return hr;
+    if (!CryptStringToBinaryA( (LPCSTR)private_blob_b64,
+                               private_blob_b64_len,
+                               CRYPT_STRING_BASE64,
+                               NULL, &private_blob_len, NULL, NULL ) ||
+        private_blob_len != sizeof( BCRYPT_ECCKEY_BLOB ) + 32 * 3)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    if (!(private_blob = malloc( private_blob_len )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (!CryptStringToBinaryA( (LPCSTR)private_blob_b64,
+                               private_blob_b64_len,
+                               CRYPT_STRING_BASE64,
+                               private_blob, &private_blob_len, NULL, NULL ))
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    header = (BCRYPT_ECCKEY_BLOB *)private_blob;
+    if (header->dwMagic != BCRYPT_ECDSA_PRIVATE_P256_MAGIC ||
+        header->cbKey != 32)
+    {
+        hr = E_INVALIDARG;
+        goto done;
+    }
+    status = BCryptImportKeyPair( g_ecdsa_alg, NULL,
+                                  BCRYPT_ECCPRIVATE_BLOB, &key,
+                                  private_blob, private_blob_len, 0 );
+    if (status)
+    {
+        hr = HRESULT_FROM_NT( status );
+        goto done;
+    }
+    status = BCryptExportKey( key, NULL, BCRYPT_ECCPUBLIC_BLOB,
+                              public_blob, sizeof( public_blob ),
+                              &public_blob_len, 0 );
+    if (status ||
+        public_blob_len != sizeof( BCRYPT_ECCKEY_BLOB ) + 32 * 2)
+    {
+        hr = status ? HRESULT_FROM_NT( status ) : E_INVALIDARG;
+        goto done;
+    }
+
+    token_wide_len = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS,
+                                          (LPCSTR)device_token,
+                                          device_token_len, NULL, 0 );
+    if (!token_wide_len)
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        goto done;
+    }
+    if (!(token_wide = malloc( token_wide_len * sizeof( *token_wide ) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS,
+                             (LPCSTR)device_token, device_token_len,
+                             token_wide, token_wide_len ) != token_wide_len)
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        goto done;
+    }
+    if (FAILED( hr = WindowsCreateString( token_wide, token_wide_len,
+                                          &token ) ))
+        goto done;
+
+    memcpy( g_pubkey_x, public_blob + sizeof( BCRYPT_ECCKEY_BLOB ), 32 );
+    memcpy( g_pubkey_y,
+            public_blob + sizeof( BCRYPT_ECCKEY_BLOB ) + 32, 32 );
+    memcpy( g_device_id, device_id, device_id_len );
+    g_device_id[device_id_len] = 0;
+    g_device_key = key;
+    g_device_token = token;
+    g_initialized = TRUE;
+    key = NULL;
+    token = NULL;
+    hr = S_OK;
+    TRACE( "loaded launcher device identity\n" );
+
+done:
+    if (key) BCryptDestroyKey( key );
+    if (token) WindowsDeleteString( token );
+    free( token_wide );
+    free( private_blob );
+    return hr;
+}
